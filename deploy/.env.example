# Configuration de production (VPS). Copiée en .env par install.sh — ne jamais versionner le .env.

# ---------- Adresse du site ----------
# Sans nom de domaine : adresse gratuite dérivée de l'IP du serveur (install.sh la remplit)
SITE_HOST=203-0-113-5.sslip.io

# ---------- Administration ----------
# Mot de passe créé au PREMIER démarrage uniquement (8 caractères min.), puis modifiable dans /admin → Sécurité
ADMIN_PASSWORD=

# ---------- Alertes des nouveaux messages (laisser vide = canal désactivé) ----------
# Telegram : créez un bot avec @BotFather (jeton), écrivez-lui un message, puis récupérez votre chat id
# (https://api.telegram.org/bot<JETON>/getUpdates). Plusieurs destinataires : séparés par des virgules.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# E-mail : brevo (brevo.com) ou resend (resend.com), clé API du service
EMAIL_PROVIDER=brevo
EMAIL_API_KEY=
EMAIL_FROM=Building Service <alertes@exemple.com>
EMAIL_TO=buldingservices97@gmail.com

# WhatsApp (API WhatsApp Business de Meta) : jeton permanent, identifiant du numéro d'envoi, destinataire(s)
WHATSAPP_TOKEN=
WHATSAPP_PHONE_ID=
WHATSAPP_TO=237656524739
# Modèle approuvé par Meta (nécessaire pour écrire hors de la fenêtre de 24 h), avec un paramètre de corps
WHATSAPP_TEMPLATE=
WHATSAPP_TEMPLATE_LANG=fr

# SMS : numéro(s) qui reçoivent les alertes (séparés par des virgules)
SMS_TO=237656524739

# MboaSMS (https://mboasms.com) : clé API du compte (Paramètres développeur) et nom d'expéditeur validé.
# Sans Sender ID validé par MboaSMS, les SMS sont refusés.
MBOASMS_API_KEY=
MBOASMS_SENDER_ID=

# Autre fournisseur HTTP (seulement si MBOASMS_API_KEY est vide) : {to} et {message} sont remplacés.
# Exemple GET  : SMS_API_URL=https://api.fournisseur.cm/send?user=XXX&key=YYY&to={to}&text={message}
# Exemple POST : SMS_API_METHOD=POST, SMS_API_BODY={"to":"{to}","message":"{message}"}, SMS_API_HEADERS={"Authorization":"Bearer ..."}
SMS_API_URL=
SMS_API_METHOD=GET
SMS_API_BODY=
SMS_API_HEADERS=

# ---------- Sauvegardes ----------
# Heure de la sauvegarde quotidienne (heure du serveur) et nombre d'archives gardées
BACKUP_HOUR=3
BACKUP_KEEP=14

# ---------- Divers ----------
MAX_UPLOAD_MB=300
