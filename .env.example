# Configuration du serveur de production (copier en .env — ce fichier-là n'est jamais versionné)

# Mot de passe de l'administration, créé au PREMIER démarrage uniquement (8 caractères minimum).
# Ensuite, changez-le depuis l'onglet Sécurité de /admin ; cette variable est alors ignorée.
ADMIN_PASSWORD=

# Adresse publique du site, utilisée pour le sitemap (sans / final)
SITE_URL=https://www.exemple.cm

# 1 si le site est derrière un proxy ou un hébergeur (Render, Railway, Coolify, nginx…)
TRUST_PROXY=1

# Taille maximale d'un fichier envoyé depuis l'admin, en Mo
MAX_UPLOAD_MB=300

# Port d'écoute dans le conteneur
PORT=8080
